PROJECT_NAME           = "Hazel OSAL"
PROJECT_BRIEF          = "Portable OS abstraction layer"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = include/hazel_wireless/kernel.h \
                         include/hazel_wireless/sys/atomic.h \
                         include/hazel_wireless/sys/atomic_types.h \
                         include/hazel_wireless/osal
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES

EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
INCLUDE_PATH           = include
PREDEFINED             = CONFIG_FREERTOS_ENABLE=1 \
                         CONFIG_ATOMIC_OPERATIONS_ARCH=1 \
                         os_thread_stack_t="void *" \
                         os_thread_tcb_t="void *" \
                         os_sem_storage_t="void *" \
                         os_thread_wait_storage_t="void *" \
                         os_mutex_storage_t="void *" \
                         os_thread_completion_storage_t="void *" \
                         os_event_storage_t="void *"
ALIASES                = atomic_api="All atomic operations include a full memory barrier."
EXCLUDE_SYMBOLS        = EINVAL EAGAIN ENOMEM EBUSY EPERM ETIMEDOUT \
                         EDEADLK ENOSPC ENODEV ECANCELED EALREADY \
                         EWOULDBLOCK Z_POLL_EVENT_OBJ_INIT Z_DECL_POLL_EVENT

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/docs-warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
QUIET                  = YES
