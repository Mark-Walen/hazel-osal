PROJECT_NAME           = "Lynx OSAL"
PROJECT_BRIEF          = "Portable OS abstraction layer"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = include/lynx_wireless/kernel.h \
                         include/lynx_wireless/sys/atomic.h \
                         include/lynx_wireless/sys/atomic_types.h \
                         include/lynx_wireless/sys/atomic_arch.h \
                         include/lynx_wireless/osal \
                         src/common
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES

EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
INCLUDE_PATH           = include
PREDEFINED             = CONFIG_FREERTOS_ENABLE=1 \
                         CONFIG_ATOMIC_OPERATIONS_ARCH=1 \
                         os_thread_stack_t="void *" \
                         os_thread_tcb_t="void *" \
                         os_sem_storage_t="void *" \
                         os_thread_wait_storage_t="void *" \
                         os_mutex_storage_t="void *" \
                         os_thread_completion_storage_t="void *" \
                         os_event_storage_t="void *"

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
WARN_LOGFILE           = build/docs-warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES
